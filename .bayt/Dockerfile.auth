# generated from bayt.cue — do not edit
FROM libraries_mecha-auth-image AS auth
ARG BAYT_DIR
WORKDIR /app
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.auth.json ./.bayt/
EXPOSE 9999
ENTRYPOINT ["deno","run","--allow-net","--allow-env","--config","/app/deno.json","/app/main.ts"]
RUN mkdir -p /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS auth_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.auth.yaml .bayt/Dockerfile.auth .bayt/bayt.auth.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=golaberto-database_bayt /monorepo /monorepo
COPY --from=golaberto-migrate_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS auth_bayt
COPY --from=auth_bayt_ctxs /monorepo /monorepo
