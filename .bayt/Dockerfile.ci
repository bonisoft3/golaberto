COPY --from=golaberto-browser_bayt /monorepo /monorepo
COPY --from=golaberto-check-constraints_bayt /monorepo /monorepo
COPY --from=golaberto-check-statistics-live_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS ci_bayt
COPY --from=ci_bayt_ctxs /monorepo /monorepo
