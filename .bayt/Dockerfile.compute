COPY --parents computations/standings.js computations/team_ratings.js computations/player_ratings.js computations/chances.js computations/cards.js computations/player_stats.js computations/golaberto-odds.wasm duckstream/standings.risingwave.json duckstream/team_ratings.risingwave.json duckstream/player_ratings.risingwave.json duckstream/chances.risingwave.json duckstream/cards.risingwave.json duckstream/player_stats.risingwave.json duckstream/bounded-standings.ts.bundle.js duckstream/bounded-team-ratings.ts.bundle.js duckstream/bounded-player-ratings.ts.bundle.js duckstream/bounded-chances.ts.bundle.js duckstream/bounded-cards.ts.bundle.js duckstream/bounded-player-stats.ts.bundle.js ./
