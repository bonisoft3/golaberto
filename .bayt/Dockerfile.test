FROM golaberto-build AS test
WORKDIR /monorepo/.
RUN ["mise", "x", "--", "cue", "vet", "-c", "./..."]
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.test.yaml .bayt/bayt.test.json ./.bayt/

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS test_ctxs
WORKDIR /monorepo/.
COPY --from=golaberto-build_srcs /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/. -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo; fi
FROM scratch AS test_srcs
COPY --from=test_ctxs /monorepo /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS test_bayt_ctxs
WORKDIR /monorepo/.
COPY --parents .bayt/compose.test.yaml .bayt/Dockerfile.test .bayt/bayt.test.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/Taskfile.test.yaml ./
COPY --from=golaberto-build_bayt /monorepo /monorepo
COPY --from=golaberto-setup_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/. -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && touch -hd @${SOURCE_DATE_EPOCH:-0} /monorepo; fi
FROM scratch AS test_bayt
COPY --from=test_bayt_ctxs /monorepo /monorepo
