# generated from bayt.cue — do not edit
FROM libraries_mecha-database-image AS timer-check
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.timer-check.json ./.bayt/
ENTRYPOINT ["psql"]
CMD ["-X", "--set=ON_ERROR_STOP=1", "--single-transaction", "--file=/timer-check.sql"]
COPY <<'TIMERS' /timer-check.sql
DO $$ BEGIN
  IF to_regprocedure('hybrid_sofa_resource.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_sofa_resource.instance i WHERE i.state->>'phase' = 'idle'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'sofa_resource', 'row', jsonb_build_object('id', i.id::text), 'state', 'idle', 'delay', 'ripe'))) THEN
    RAISE EXCEPTION 'machine sofa_resource has instances in idle whose ripe timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_sofa_resource.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_sofa_resource.instance i WHERE i.state->>'phase' = 'acquiring'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'sofa_resource', 'row', jsonb_build_object('id', i.id::text), 'state', 'acquiring', 'delay', 'ripe'))) THEN
    RAISE EXCEPTION 'machine sofa_resource has instances in acquiring whose ripe timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_sofa_resource.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_sofa_resource.instance i WHERE i.state->>'phase' = 'backoff'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'sofa_resource', 'row', jsonb_build_object('id', i.id::text), 'state', 'backoff', 'delay', 'ripe'))) THEN
    RAISE EXCEPTION 'machine sofa_resource has instances in backoff whose ripe timer the ticker was never given';
  END IF;
END $$;
DO $$ BEGIN
  IF to_regprocedure('hybrid_sofa_provider.arm(uuid, bigint, jsonb, bigint)') IS NULL AND EXISTS (SELECT FROM hybrid_sofa_provider.instance i WHERE i.state->>'phase' = 'blocked'
      AND NOT EXISTS (SELECT FROM public.schedule s WHERE s.emits_entity = 'machine_timer_tick'
        AND s.emits_values @> jsonb_build_object('machine', 'sofa_provider', 'row', jsonb_build_object('id', i.id::text), 'state', 'blocked', 'delay', 'block'))) THEN
    RAISE EXCEPTION 'machine sofa_provider has instances in blocked whose block timer the ticker was never given';
  END IF;
END $$;
TIMERS

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS timer-check_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.timer-check.yaml .bayt/Dockerfile.timer-check .bayt/bayt.timer-check.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=golaberto-database_bayt /monorepo /monorepo
COPY --from=golaberto-migrate_bayt /monorepo /monorepo
COPY --from=golaberto-airlock-upgrade_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS timer-check_bayt
COPY --from=timer-check_bayt_ctxs /monorepo /monorepo
