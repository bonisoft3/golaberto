COPY --parents .bayt/compose.transform.yaml .bayt/Dockerfile.transform .bayt/bayt.transform.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=golaberto-redis_bayt /monorepo /monorepo
COPY --from=golaberto-crud_bayt /monorepo /monorepo
COPY --from=golaberto-compute_bayt /monorepo /monorepo
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS transform_bayt
COPY --from=transform_bayt_ctxs /monorepo /monorepo
