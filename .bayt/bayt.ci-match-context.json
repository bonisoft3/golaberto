              "var": {
                "contents": "CACHE_SCOPE"
              }
            },
            {
              "id": "cache_scope_fallback",
              "var": {
                "contents": "CACHE_SCOPE_FALLBACK"
              }
            },
            {
              "id": "sayt_buildkit_syntax",
              "var": {
                "contents": "BUILDKIT_SYNTAX"
              }
            },
            {
              "id": "sayt_no_cache",
              "var": {
