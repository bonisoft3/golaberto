              }
            },
            {
              "id": "sayt_no_cache_to",
              "var": {
                "contents": "SAYT_NO_CACHE_TO"
              }
            },
            {
              "id": "depot_token",
              "var": {
                "contents": "DEPOT_TOKEN"
              }
            },
            {
              "id": "depot_project_id",
              "var": {
                "contents": "DEPOT_PROJECT_ID"
              }
            },
            {
              "id": "depot_org_id",
              "var": {
                "contents": "DEPOT_ORG_ID"
              }
            },
            {
              "id": "depot_disable_otel",
              "var": {
                "contents": "DEPOT_DISABLE_OTEL"
              }
            },
            {
              "id": "actions_results_url",
              "var": {
                "contents": "ACTIONS_RESULTS_URL"
              }
            },
            {
              "id": "actions_runtime_token",
              "var": {
                "contents": "ACTIONS_RUNTIME_TOKEN"
              }
