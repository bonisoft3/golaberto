    "epilogue": [
      "COPY <<'COMPUTE' /compute-events.yaml\ninput:\n  redis_streams:\n    url: ${REDIS_URL}\n    streams: [cdc-events]\n    body_key: data\n    consumer_group: ${COMPUTE_GROUP}\n    client_id: compute\n    start_from_oldest: true\n    auto_replay_nacks: true\n    # A backlog is read in large steps so one batch below drains much of it.\n    limit: 1000\npipeline:\n  threads: 1\n  processors:\n    - mapping: |\n        let table = this.data.parse_json().__table\n        root.tables = [if $table.type() == \"string\" && $table != \"\" { $table } else { throw(\"CDC event has no table\") }]\noutput:\n  switch:\n    cases:\n      - check: errored()\n        output:\n          reject: ${! error() }\n      # An invalidation says the named tables changed since the last run, and\n      # a run reads a fresh snapshot, so one run answers every invalidation\n      # pending before it. What arrives within a period goes out as one, its\n      # tables united; while a run is in flight the next batch waits, and what\n      # arrives meanwhile waits in the stream for the batch after. A batch is\n      # acknowledged only once compute accepts it.\n      #\n      # Compute answers a failed delivery 500, the error in the body, and keeps\n      # serving; the batch is retried here as the one message it became, with\n      # exponential backoff. A delivery still refused after twelve retries\n      # (about eight minutes of backoff) is no transient failure: crash, so the\n      # stack fails loudly. The delivery stays pending and is replayed first\n      # when Connect restarts.\n      - output:\n          broker:\n            pattern: fan_out\n            batching:\n              count: 10000\n              period: 1s\n              processors:\n                - archive:\n                    format: json_array\n                - mapping: root.tables = this.map_each(m -> m.tables).flatten().unique()\n            outputs:\n              - fallback:\n                  - retry:\n                      backoff:\n                        initial_interval: 1s\n                        max_interval: 1m\n                        max_elapsed_time: 0s\n                      max_retries: 12\n                      output:\n                        http_client:\n                          url: http://compute:9997/invalidate\n                          verb: POST\n                          timeout: 30m\n                          retries: 0\n                          max_in_flight: 1\n                          headers:\n                            Content-Type: application/json\n                            Authorization: Bearer ${SERVICE_JWT:}\n                  - drop: {}\n                    processors:\n                      - crash: 'compute refused an invalidation through every retry: ${! @fallback_error }'\n\nCOMPUTE"
    ],
