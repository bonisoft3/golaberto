{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "mise exec -- deno run --allow-read --allow-write=. --allow-run --allow-env ../../plugins/pronto/write.ts .",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "mise exec -- cue vet -c ./...",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
