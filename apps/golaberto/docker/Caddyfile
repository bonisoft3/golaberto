      @route path / /arbitro/* /arbitro/*/ /arbitros /arbitros/ /campeonato/* /campeonato/*/ /campeonatos /campeonatos/ /chances/* /chances/*/ /de /de/ /de/bearbeiten/* /de/bearbeiten/*/ /de/chancen/* /de/chancen/*/ /de/mannschaft-meisterschaft/*/* /de/mannschaft-meisterschaft/*/*/ /de/mannschaft/* /de/mannschaft/*/ /de/mannschaften /de/mannschaften/ /de/schiedsrichter/* /de/schiedsrichter/*/ /de/spiel/* /de/spiel/*/ /de/spiele /de/spiele/ /de/spieler/* /de/spieler/*/ /de/stadien /de/stadien/ /de/stadion/* /de/stadion/*/ /de/unparteiische /de/unparteiische/ /de/wettbewerb/* /de/wettbewerb/*/ /de/wettbewerbe /de/wettbewerbe/ /editar/* /editar/*/ /en /en/ /en/championship/* /en/championship/*/ /en/championships /en/championships/ /en/chances/* /en/chances/*/ /en/edit/* /en/edit/*/ /en/match/* /en/match/*/ /en/matches /en/matches/ /en/player/* /en/player/*/ /en/referee/* /en/referee/*/ /en/referees /en/referees/ /en/stadium/* /en/stadium/*/ /en/stadiums /en/stadiums/ /en/team-championship/*/* /en/team-championship/*/*/ /en/team/* /en/team/*/ /en/teams /en/teams/ /equipe-campeonato/*/* /equipe-campeonato/*/*/ /equipe/* /equipe/*/ /equipes /equipes/ /es /es/ /es/arbitro/* /es/arbitro/*/ /es/arbitros /es/arbitros/ /es/campeonato/* /es/campeonato/*/ /es/campeonatos /es/campeonatos/ /es/chances/* /es/chances/*/ /es/editar/* /es/editar/*/ /es/equipo-campeonato/*/* /es/equipo-campeonato/*/*/ /es/equipo/* /es/equipo/*/ /es/equipos /es/equipos/ /es/estadio/* /es/estadio/*/ /es/estadios /es/estadios/ /es/jugador/* /es/jugador/*/ /es/partido/* /es/partido/*/ /es/partidos /es/partidos/ /estadio/* /estadio/*/ /estadios /estadios/ /fr /fr/ /fr/arbitre/* /fr/arbitre/*/ /fr/arbitres /fr/arbitres/ /fr/championnat/* /fr/championnat/*/ /fr/championnats /fr/championnats/ /fr/chances/* /fr/chances/*/ /fr/equipe-championnat/*/* /fr/equipe-championnat/*/*/ /fr/equipe/* /fr/equipe/*/ /fr/equipes /fr/equipes/ /fr/joueur/* /fr/joueur/*/ /fr/match/* /fr/match/*/ /fr/matchs /fr/matchs/ /fr/modifi