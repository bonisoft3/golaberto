        rewrite @novo-jogo_it /it/partite/nuovo
        @usuario_de {
          path_regexp usuario ^/usuario/([^/]+)$
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(de-DE|de)$
        }
        rewrite @usuario_de /de/benutzer/{re.usuario.1}
        @usuario_en {
          path_regexp usuario ^/usuario/([^/]+)$
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(en-US|en)$
        }
        rewrite @usuario_en /en/user/{re.usuario.1}
        @usuario_es {
          path_regexp usuario ^/usuario/([^/]+)$
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(es-AR|es)$
        }
        rewrite @usuario_es /es/usuario/{re.usuario.1}
        @usuario_fr {
          path_regexp usuario ^/usuario/([^/]+)$
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(fr-FR|fr)$
        }
        rewrite @usuario_fr /fr/utilisateur/{re.usuario.1}
        @usuario_it {
          path_regexp usuario ^/usuario/([^/]+)$
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(it-IT|it)$
        }
        rewrite @usuario_it /it/utente/{re.usuario.1}
        @usuarios_de {
          path /usuarios
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(de-DE|de)$
        }
        rewrite @usuarios_de /de/gemeinschaft
        @usuarios_en {
          path /usuarios
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(en-US|en)$
        }
        rewrite @usuarios_en /en/community
        @usuarios_es {
          path /usuarios
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(es-AR|es)$
        }
        rewrite @usuarios_es /es/comunidad
        @usuarios_fr {
          path /usuarios
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(fr-FR|fr)$
        }
        rewrite @usuarios_fr /fr/communaute
        @usuarios_it {
          path /usuarios
          not query lang=*
          vars_regexp {re.lang.1} (?i)^(it-IT|it)$
        }
        rewrite @usuarios_it /it/comunita
      }
    }
    @rendered {
      expression `{http.request.uri}.matches("^(?:/de/spiele/archiv/?|/en/matches/archive/?|/es/partidos/archivo/?|/fr/matchs/archives/?|/it/partite/archivio/?|/jogos/arquivo/?|/de/wettbewerb/[^/?]+/spiele/?|/en/championship/[^/?]+/matches/?|/es/campeonato/[^/?]+/partidos/?|/fr/championnat/[^/?]+/matchs/?|/it/campionato/[^/?]+/partite/?|/campeonato/[^/?]+/jogos/?|/de/wettbewerb/[^/?]+/zuschauer/?|/en/championship/[^/?]+/attendance/?|/es/campeonato/[^/?]+/asistencia/?|/fr/championnat/[^/?]+/affluence/?|/it/campionato/[^/?]+/presenze/?|/campeonato/[^/?]+/publico/?|/de/wettbewerb/[^/?]+/spieler/?|/en/championship/[^/?]+/players/?|/es/campeonato/[^/?]+/jugadores/?|/fr/championnat/[^/?]+/joueurs/?|/it/campionato/[^/?]+/giocatori/?|/campeonato/[^/?]+/jogadores/?|/de/wettbewerb/[^/?]+/mannschaft/[^/?]+/spieler/[^/?]+/?|/en/championship/[^/?]+/team/[^/?]+/player/[^/?]+/?|/es/campeonato/[^/?]+/equipo/[^/?]+/jugador/[^/?]+/?|/fr/championnat/[^/?]+/equipe/[^/?]+/joueur/[^/?]+/?|/it/campionato/[^/?]+/squadra/[^/?]+/giocatore/[^/?]+/?|/campeonato/[^/?]+/equipe/[^/?]+/jogador/[^/?]+/?|/de/?|/en/?|/es/?|/fr/?|/it/?|/|/de/wettbewerbe/?|/en/championships/?|/es/campeonatos/?|/fr/championnats/?|/it/campionati/?|/campeonatos/?|/de/spiele/?|/en/matches/?|/es/partidos/?|/fr/matchs/?|/it/partite/?|/jogos/?|/de/spiel/[^/?]+/?|/en/match/[^/?]+/?|/es/partido/[^/?]+/?|/fr/match/[^/?]+/?|/it/partita/[^/?]+/?|/jogo/[^/?]+/?|/de/gruppe/[^/?]+/chancen/?|/en/group/[^/?]+/chances/?|/es/grupo/[^/?]+/chances/?|/fr/groupe/[^/?]+/chances/?|/it/gruppo/[^/?]+/probabilita/?|/grupo/[^/?]+/chances/?|/de/mannschaften/?|/en/teams/?|/es/equipos/?|/fr/equipes/?|/it/squadre/?|/equipes/?|/de/spieler/?|/en/players/?|/es/jugadores/?|/fr/joueurs/?|/it/giocatori/?|/jogadores/?|/de/stadien/?|/en/stadiums/?|/es/estadios/?|/fr/stades/?|/it/stadi/?|/estadios/?|/de/stadion/[^/?]+/?|/en/stadium/[^/?]+/?|/es/estadio/[^/?]+/?|/fr/stade/[^/?]+/?|/it/stadio/[^/?]+/?|/estadio/[^/?]+/?|/de/unparteiische/?|/en/referees/?|/es/arbi